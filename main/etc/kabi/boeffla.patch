+	{
+#endif
 	ws->event_count++;
 	/* This is racy, but the counter is approximate anyway. */
 	if (events_check_enabled)
@@ -591,6 +656,10 @@ static void wakeup_source_report_event(struct wakeup_source *ws, bool hard)
 	if (!ws->active)
 		wakeup_source_activate(ws);
 
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+	}
+#endif
+
 	if (hard)
 		pm_system_wakeup();
 }
