+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+			if (!check_for_block(ws))	// AP: check if wakelock is on wakelock blocker list
+#endif
 			active = 1;
 		} else if (!active &&
 			   (!last_activity_ws ||
